#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        //input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
        input-processors = <&zip_wheel_scaler 1 5>; //スクロールを遅くする
    };
};

&trackball_listener {
    scroller {
        layers = <FUNCTION>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
            //スクロール方向を逆転,,,,,,,,,,,,,,,,,,,,,,,,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        ZenkakuHankaku {
            bindings = <&none>;
            key-positions = <11 12>;
        };

        DeleteKey {
            bindings = <&none>;
            key-positions = <7 8>;
        };

        InsertKey {
            bindings = <&none>;
            key-positions = <6 7>;
        };

        CenterClick {
            bindings = <&none>;
            key-positions = <17 16>;
        };

        RightClick {
            bindings = <&none>;
            key-positions = <18 17>;
        };

        PrevClick {
            bindings = <&none>;
            key-positions = <27 28>;
        };

        ClickNext {
            bindings = <&none>;
            key-positions = <26 27>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                 &kp W         &kp E  &kp R                   &kp T                                                 &kp Y             &kp U  &kp I       &kp O                    &kp P
&kp A                 &kp S         &kp D  &kp F                   &kp G                                                 &kp H             &kp J  &kp K       &kp L                    &kp BACKSPACE
&kp Z                 &kp X         &kp C  &kp V                   &kp B                                                 &kp N             &kp M  &kp COMMA   &kp DOT                  &kp ENTER
&mt LEFT_COMMAND TAB  &kp LEFT_ALT  &none  &mt LEFT_CONTROL MINUS  &mt LEFT_SHIFT LANGUAGE_2  &lt 3 ESCAPE    &kp SPACE  &lt 2 LANGUAGE_1         &lt 5 SEMI  &mt RIGHT_CONTROL SLASH  &lt 4 MINUS
            >;

            sensor-bindings = <&mouse_scrl SCRL_UP SCRL_DOWN>;
        };

        //1

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans  &trans
            >;
        };

        //2

        MARK {
            bindings = <
&kp EXCLAMATION  &kp AT         &kp HASH  &kp DOLLAR  &kp PERCENT                    &kp CARET      &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp LCTRL        &kp AMPERSAND  &none     &none       &kp PLUS                       &kp MINUS      &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &trans
&none            &none          &none     &none       &none                          &kp BACKSLASH  &kp GRAVE      &kp SEMICOLON     &kp SQT               &trans
&trans           &trans         &trans    &trans      &trans       &trans    &trans  &trans                        &trans            &trans                &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_LEFT SCRL_RIGHT>;
        };

        //3

        CURSOR {
            bindings = <
&kp LG(LA(O))      &kp LA(LG(P))          &kp LG(LA(LEFT_BRACKET))  &kp LA(LG(RIGHT_BRACKET))   &kp LG(LC(LS(NUMBER_4)))                       &kp KP_MINUS  &kp N7        &kp N8        &kp N9        &kp ASTERISK
&kp LA(LG(L))      &kp LA(LG(SEMICOLON))  &kp LG(LA(SQT))           &kp LA(LG(LEFT_ARROW))      &kp LG(LA(RIGHT_ARROW))                        &kp KP_PLUS   &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp BACKSPACE
&kp LA(LG(COMMA))  &kp LA(LG(PERIOD))     &kp LG(LA(SLASH))         &kp LS(LA(LG(LEFT_ARROW)))  &kp LS(LA(LG(RIGHT_ARROW)))                    &kp SLASH     &kp NUMBER_1  &kp NUMBER_2  &kp N3        &kp ENTER
&trans             &trans                 &trans                    &trans                      &trans                       &trans    &trans  &kp NUMBER_0                &kp COMMA     &kp PERIOD    &kp SLASH
            >;

            sensor-bindings = <&mouse_scrl SCRL_LEFT SCRL_RIGHT>;
        };

        //4

        FUNCTION {
            bindings = <
&kp F1             &kp F2             &kp F3             &kp F4   &kp F5                                 &none                &none           &none           &none            &kp DELETE
&kp F6             &kp F7             &kp F8             &kp F9   &kp F10                                &kp LC(UP_ARROW)     &none           &kp UP_ARROW    &none            &none
&kp LA(LG(LS(S)))  &kp LA(LG(LS(F)))  &kp LS(LG(LA(T)))  &kp F11  &kp F12                                &kp LC(DOWN_ARROW)   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none
&trans             &trans             &trans             &trans   &trans   &trans    &kp LC(LEFT_ARROW)  &kp LC(RIGHT_ARROW)                  &none           &none            &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_LEFT SCRL_RIGHT>;
        };

        //5
        //6

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };
    };
};
